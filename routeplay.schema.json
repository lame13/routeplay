{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lame13/routeplay/main/routeplay.schema.json",
  "title": "RoutePlay configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["baseUrl", "transitions"],
  "properties": {
    "$schema": { "type": "string" },
    "baseUrl": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "expectedFinalUrl": { "type": "string", "minLength": 1 },
          "selector": { "type": "string", "minLength": 1 },
          "mainSelector": { "type": "string", "minLength": 1 },
          "ignoreSelectors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "readySelector": { "type": "string", "minLength": 1 },
          "expectedStatus": { "type": "integer", "minimum": 100, "maximum": 599, "default": 200 },
          "requireClientNavigation": { "type": "boolean", "default": false },
          "paths": {
            "type": "array",
            "description": "Source globs that make this transition relevant to --only-changed. An empty list always runs.",
            "items": { "type": "string", "minLength": 1 }
          },
          "expect": {
            "type": "object",
            "description": "Semantic values that must hold in server HTML, a cold load, and in-app navigation.",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "canonical": { "type": "string", "minLength": 1 },
              "h1": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "lang": { "type": "string", "minLength": 1 },
              "robots": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": { "minLength": 1 },
                "additionalProperties": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "jsonLdTypesInclude": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "mainTextIncludes": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "linksInclude": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000, "default": 20000 },
        "settleMs": { "type": "integer", "minimum": 100, "maximum": 10000, "default": 500 },
        "locale": { "type": "string", "default": "en-US" },
        "timezoneId": { "type": "string", "default": "UTC" },
        "userAgent": { "type": "string", "minLength": 1 },
        "storageState": {
          "type": "string",
          "minLength": 1,
          "description": "Playwright storage state file reused for authenticated routes. Resolved from the working directory."
        },
        "cookies": {
          "type": "array",
          "description": "Cookies seeded into every capture context. Values may use ${ENV_VAR} placeholders and are redacted from reports.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "allOf": [
              { "not": { "required": ["url", "domain"] } },
              { "not": { "required": ["url", "path"] } }
            ],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "value": { "type": "string" },
              "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
              "domain": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1, "pattern": "^/" },
              "httpOnly": { "type": "boolean" },
              "secure": { "type": "boolean" },
              "sameSite": { "enum": ["Strict", "Lax", "None"] },
              "expires": { "type": "number" }
            }
          }
        },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 320, "maximum": 7680 },
            "height": { "type": "integer", "minimum": 240, "maximum": 4320 }
          }
        }
      }
    },
    "compare": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minTextSimilarity": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.98 },
        "minSourceTextLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000,
          "default": 80
        },
        "compareLinks": { "type": "boolean", "default": true }
      }
    },
    "headers": {
      "type": "object",
      "description": "Request headers applied only to the audited origin. Values may use ${ENV_VAR} placeholders.",
      "additionalProperties": { "type": "string" }
    },
    "failOn": { "enum": ["error", "warning", "never"], "default": "error" },
    "concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "default": 1,
      "description": "How many transitions are captured at once. Each transition keeps clean browser contexts."
    },
    "retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "default": 0,
      "description": "Extra attempts for a transition that is incomplete or still violates the configured policy."
    },
    "repeat": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "default": 1,
      "description": "Captures per transition. Values above 1 report fields that change between identical captures."
    },
    "ignore": {
      "type": "array",
      "description": "Findings accepted for now. Evidence stays in the report, and an expired suppression reports itself.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "reason"],
        "properties": {
          "ruleId": { "type": "string", "pattern": "^(?:RP[0-9]{3}|\\*)$" },
          "reason": { "type": "string", "minLength": 1 },
          "transition": { "type": "string", "minLength": 1 },
          "until": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        }
      }
    },
    "artifacts": {
      "type": "string",
      "minLength": 1,
      "description": "Directory where failure screenshots, settled DOM, and runtime events are written."
    }
  }
}
